# --- Database (PostgreSQL) ---
# Locally: any Postgres. On Neon/Vercel: use the POOLED connection string here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio?schema=public"
# Direct (non-pooled) connection used by Prisma for migrations / db push.
# Locally identical to DATABASE_URL; on Neon use the non-pooled host here.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/portfolio?schema=public"

# --- Auth.js (NextAuth v4) ---
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Seed credentials (used by `npm run db:seed` only) ---
ADMIN_EMAIL="berlinkoueni25@gmail.com"
# Generate a unique password of at least 16 characters.
ADMIN_PASSWORD=""

# --- Public site identity ---
# Use the canonical public HTTPS origin in production (no path).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Berlinkoueni (theghostshell)"

# Use at least 24 random lowercase letters/numbers after the slash in production.
# Legacy /admin renders a 404 when a custom path is set.
ADMIN_PATH="/replace-with-a-long-random-path"
